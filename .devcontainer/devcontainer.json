{
  "name": "MAVIS Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "updateContentCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "streamlit run inicio.py --server.enableCORS true --server.enableXsrfProtection true",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "MAVIS", "onAutoForward": "openPreview"}}
}
